{
  "name": "riddles",
  "version": "0.7.0",
  "private": true,
  "description": "Installable offline puzzle games as a Progressive Web App.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stefanniedermaier/riddles.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "knip": "knip",
    "icons": "pwa-assets-generator",
    "check:deps": "node scripts/check-dependencies.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "audit:ci": "npm audit signatures && npm audit --omit=dev --audit-level=moderate && npm audit --audit-level=high",
    "release:check": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "vue": "^3.5.45",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node26": "^26.0.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "npm-run-all2": "^9.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.2"
    },
    "js-beautify": {
      "glob": "^14.0.2",
      "editorconfig": "^4.0.0"
    }
  }
}
